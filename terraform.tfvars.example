# Set subscription_id to a specific subscription ID, or leave null to use
# the currently selected subscription from `az login` / `az account set`.
subscription_id = null

location                      = "uksouth"
vm_resource_group_name         = "VMalert"
# This creates one Linux VM and one Windows VM. Add another named entry here
# when you want Terraform to create and monitor an additional VM.
vms = {
  linux-vm = {
    os   = "Linux"
    size = "Standard_B1s"
  }
  windows-vm = {
    os   = "Windows"
    size = "Standard_B2s"
  }
}

# Standard_B1s may be free-tier eligible, but Azure pricing/eligibility varies.
admin_username = "linuxadmin"

# Set a strong password of at least 12 characters. Keep it private.
admin_password = null

# Use your public IP in CIDR notation (for example, "203.0.113.25/32") to
# restrict SSH/RDP. "*" allows access from anywhere and is intended only for
# temporary testing.
admin_source_cidr = "*"

# These ranges support multiple VMs; use only if they do not overlap any
# connected/on-premises networks.
vnet_address_space      = ["10.42.0.0/24"]
subnet_address_prefixes = ["10.42.0.0/24"]

log_analytics_workspace_name = "la-customvm-uks-001"
log_analytics_retention_days = 30
dcr_name                     = "dcr-customvm-uks-001"

cpu_alert_name          = "vm-high-cpu"
availability_alert_name = "vm-missing-heartbeat"
guest_errors_alert_name = "vm-guest-errors"
low_memory_alert_name   = "vm-low-memory"
low_disk_alert_name     = "vm-low-disk-space"

cpu_threshold_percent                = 80
disk_free_space_threshold_percent    = 10
memory_used_percent_threshold        = 90
available_memory_mb_threshold        = 500
evaluation_frequency                 = "PT1M"
log_alert_evaluation_frequency       = "PT5M"

tags = {
  managed_by = "terraform"
  purpose    = "vm-monitoring"
}
